# ════════════════════════════════════════════════════════════════════════
# UniTune — variabili d'ambiente
# Copia questo file in `.env` (o `.env.local`) e compila i valori.
# Senza VITE_SUPABASE_* l'app parte in MODALITÀ DEMO: dati sul dispositivo
# e catalogo di ricerca dimostrativo.
# ════════════════════════════════════════════════════════════════════════

# ── Client (finiscono nel bundle JS: SOLO valori pubblici) ───────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://<id-progetto>.supabase.co
# Chiave pubblica "anon"/"publishable": è sicura nel client perché i dati
# sono protetti dalle policy RLS (supabase/migrations).
VITE_SUPABASE_ANON_KEY=<anon-key>

# true  = ricerca sul catalogo dimostrativo (nessuna quota consumata);
# false = ricerca reale tramite la Edge Function `youtube`.
VITE_USE_MOCKS=true

# Opzionali: API pubblica di Audius (nessuna chiave necessaria).
# VITE_AUDIUS_API=https://api.audius.co/v1
# VITE_AUDIUS_APP_NAME=UniTune

# ── Server (NON letta da Vite, NON finisce nel client) ───────────────────
# Chiave della YouTube Data API v3, usata solo dalla Edge Function.
# Non si mette qui per il deploy: si salva come secret di Supabase con
#   npx supabase secrets set YOUTUBE_API_KEY=...
# Qui serve solo per lo sviluppo locale della funzione:
#   npx supabase functions serve youtube --env-file .env
YOUTUBE_API_KEY=

# Origini autorizzate a chiamare la Edge Function (CORS), separate da virgola.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Opzionali (valori di default tra parentesi):
# YT_MAX_SEARCHES_PER_USER_DAY=40   tetto ricerche per utente al giorno
# YT_CACHE_TTL_HOURS=24             durata cache risultati (max 720 = 30 giorni)
# YT_REGION_CODE=IT
# YT_RELEVANCE_LANGUAGE=it
